# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — real secrets never get committed.
# ---------------------------------------------------------------------------

# Admin dashboard password. This is the only thing protecting customer contact
# details, so make it long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=

# Secret used to sign the admin login cookie. Any long random string.
# Changing it logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# LEAVE BLANK FOR LOCAL DEVELOPMENT. When empty, the app uses an embedded
# Postgres (PGlite) stored in ./.pglite — no database server needed.
#
# In production set this to the Neon connection string, e.g.
#   postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional features — the app works without any of these.
# ---------------------------------------------------------------------------

# Photo uploads on the quote form. Uploads are hidden until this is set.
# Get it from the Vercel dashboard: Storage -> Blob -> connect to project.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (free bot protection). If both are blank the form still
# works and still uses the honeypot + timing + rate-limit defenses.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email notification on new leads. Deliberately OFF for now — the owner is
# using the dashboard. To turn it on later: sign up at resend.com, verify the
# domain, then set both values. No code changes needed.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Public site URL, used for canonical tags and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Launch switch
# ---------------------------------------------------------------------------
# Leave unset (or anything other than "true") and the entire site is hidden
# from search engines: robots.txt disallows everything and every page carries a
# noindex tag. This is what lets the site be deployed and shared for review
# without Google indexing an unfinished version.
#
# Set to exactly "true" as the FINAL step of launch, once the real photos and
# confirmed business details are in.
SITE_INDEXABLE=
